# ---------------------------------------------------------------------------
# Learnora backend configuration. Copy to `.env` and edit. NEVER commit .env.
# ---------------------------------------------------------------------------

# dev | prod. In prod, dev-only endpoints and the mock payment provider are disabled.
ENV=dev

# PostgreSQL. Learnora persists every write here; the API refuses to start without it.
# SQLite is only accepted when ENV=test (the automated test suite).
DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/skillearn

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Subscription ----------------------------------------------------------
SUBSCRIPTION_PRICE_PAISE=14900
SUBSCRIPTION_DAYS=30

# ---- Reward safety ---------------------------------------------------------
# Global kill switch. When false, no new rewards are granted (existing ones stay).
REWARDS_ENABLED=true
# Max total rewards a single user can earn per calendar day (paise).
REWARD_DAILY_LIMIT_PAISE=50000
# Max reward a single task may pay out (paise). Tasks above this are rejected on create.
REWARD_PER_TASK_LIMIT_PAISE=20000
# Paid once per lesson when its video is watched to the end (paise). 0 turns it off.
VIDEO_REWARD_PAISE=500
# Admin report warns when rewards paid exceed this % of revenue.
REWARD_MAX_PERCENT_OF_REVENUE=50
# Minimum seconds between two submissions on the same task by the same user.
ATTEMPT_COOLDOWN_SECONDS=10
# Max submissions per user per minute (protects grading endpoints).
SUBMISSION_RATE_LIMIT_PER_MINUTE=20

# ---- Payments --------------------------------------------------------------
# mock | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Quiz writing (optional) ------------------------------------------------
# Groq writes a quiz from each lesson's notes. Optional: the quizzes shipped
# with `python scripts/seed.py` are complete and work without a key.
# Get one at https://console.groq.com/keys and run
#   python scripts/generate_quizzes.py --course C --limit 2
# to try it on two lessons first.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
QUIZ_QUESTIONS_PER_TOPIC=5

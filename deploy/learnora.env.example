# Copy to /etc/learnora/learnora.env and chmod 600.
ENV=production
DATABASE_URL=postgresql+psycopg://learnora:CHANGE_ME@YOUR_RDS_HOST:5432/skillearn
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
CORS_ORIGINS=https://your-domain.example
SEED_ON_START=true
SEED_ADMIN_NAME=Learnora Admin
SEED_ADMIN_EMAIL=admin@your-domain.example
SEED_ADMIN_PASSWORD=CHANGE_ME_BEFORE_FIRST_BOOT
PAYMENT_PROVIDER=mock
REWARDS_ENABLED=true

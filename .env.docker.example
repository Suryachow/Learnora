# ---------------------------------------------------------------------------
# Learnora Docker stack configuration.
# Copy to `.env.docker`, fill in the secrets, then run:
#     docker compose --env-file .env.docker up -d --build
# NEVER commit .env.docker.
# ---------------------------------------------------------------------------

# Port the website is published on. Put a TLS-terminating proxy in front of it
# for a real domain (see the README).
HTTP_PORT=8080

# ---- Database --------------------------------------------------------------
POSTGRES_DB=skillearn
POSTGRES_USER=skillearn
# URL-safe characters only (A-Z a-z 0-9 - _ .): the value is embedded in
# DATABASE_URL, so "@", ":" or "/" would break the connection string.
POSTGRES_PASSWORD=change-me-postgres-password

# ---- API -------------------------------------------------------------------
# production | dev. Production turns off dev-only endpoints and the mock
# payment provider.
ENV=production

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Uvicorn worker processes. Rule of thumb: 2 per CPU core.
API_WORKERS=2

# Public origin of the site, e.g. https://learnora.example.com
CORS_ORIGINS=http://localhost:8080

# ---- First boot ------------------------------------------------------------
# Seeds the admin user and the C/D course catalogue, but only when the database
# holds no courses yet. Set to false once the site is live.
SEED_ON_START=true
SEED_ADMIN_NAME=Learnora Admin
SEED_ADMIN_EMAIL=admin@skillearn.dev
# Required when SEED_ON_START=true and ENV is not dev. Use a long unique value -
# this account can edit the catalogue and read learner data.
SEED_ADMIN_PASSWORD=change-me-strong-admin-password

# ---- Rewards ---------------------------------------------------------------
REWARDS_ENABLED=true
REWARD_DAILY_LIMIT_PAISE=50000
REWARD_PER_TASK_LIMIT_PAISE=20000
VIDEO_REWARD_PAISE=500
REWARD_MAX_PERCENT_OF_REVENUE=50
ATTEMPT_COOLDOWN_SECONDS=10
SUBMISSION_RATE_LIMIT_PER_MINUTE=20

# ---- Payments (not finished - left as shipped) ------------------------------
# mock | razorpay. With ENV=production the mock provider is inert, so checkout
# only works once Razorpay keys are filled in below.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SUBSCRIPTION_PRICE_PAISE=14900
SUBSCRIPTION_DAYS=30

# ---- Quiz writing (optional) ------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
QUIZ_QUESTIONS_PER_TOPIC=5
